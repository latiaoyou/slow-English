[{"id":"hi","en":"hi","zh":"嗨","ipa":"/haɪ/","pack":"starter","tags":[],"pos":"叹","example":"Hi, my friend.","exampleZh":"嗨，我的朋友。","mnemonic":"读作「嗨」，抬一下手就行。你已经会了。"},{"id":"hello","en":"hello","zh":"你好","ipa":"/həˈloʊ/","pack":"starter","tags":[],"pos":"叹","example":"Hello, I am here.","exampleZh":"你好，我在这里。","mnemonic":"比 hi 多两拍：he-lo。"},{"id":"hey","en":"hey","zh":"嘿","ipa":"/heɪ/","pack":"starter","tags":[],"pos":"叹","example":"Hey, look at this.","exampleZh":"嘿，看这个。","mnemonic":"和中文「嘿」一样，用来叫人。"},{"id":"morning","en":"morning","zh":"早上","ipa":"/ˈmɔrnɪŋ/","pack":"starter","tags":[],"pos":"名","example":"Good morning.","exampleZh":"早上好。","mnemonic":"more-ning，早上光更多。你已经会了。"},{"id":"afternoon","en":"afternoon","zh":"下午","ipa":"/ˌæftərˈnun/","pack":"starter","tags":[],"pos":"名","example":"Good afternoon.","exampleZh":"下午好。","mnemonic":"after noon，中午过去就是它。"},{"id":"evening","en":"evening","zh":"傍晚","ipa":"/ˈivnɪŋ/","pack":"starter","tags":[],"pos":"名","example":"Good evening.","exampleZh":"晚上好。","mnemonic":"天要暗时说，比 night 早。"},{"id":"night","en":"night","zh":"夜晚","ipa":"/naɪt/","pack":"starter","tags":[],"pos":"名","example":"Good night.","exampleZh":"晚安。","mnemonic":"睡觉前的再见。"},{"id":"good","en":"good","zh":"好","ipa":"/ɡʊd/","pack":"starter","tags":[],"pos":"形","example":"Have a good day.","exampleZh":"祝你今天好。","mnemonic":"短短的「古德」。你已经会了。"},{"id":"bye","en":"bye","zh":"再见","ipa":"/baɪ/","pack":"starter","tags":[],"pos":"叹","example":"Bye, my friend.","exampleZh":"再见，我的朋友。","mnemonic":"像把手当「掰」开。"},{"id":"goodbye","en":"goodbye","zh":"再见","ipa":"/ˌɡʊdˈbaɪ/","pack":"starter","tags":[],"pos":"叹","example":"Goodbye, see you.","exampleZh":"再见，回头见。","mnemonic":"good 加 bye，好好地告别。"},{"id":"please","en":"please","zh":"请","ipa":"/pliz/","pack":"starter","tags":[],"pos":"叹","example":"Water, please.","exampleZh":"请给我水。","mnemonic":"放在句尾，话就变软。"},{"id":"thank","en":"thank","zh":"谢谢","ipa":"/θæŋk/","pack":"starter","tags":[],"pos":"动","example":"Thank you.","exampleZh":"谢谢你。","mnemonic":"舌尖轻轻伸出，常和 you 连说。"},{"id":"thanks","en":"thanks","zh":"谢谢","ipa":"/θæŋks/","pack":"starter","tags":[],"pos":"叹","example":"Thanks a lot.","exampleZh":"非常感谢。","mnemonic":"thank 后面加 s，更随便。"},{"id":"sorry","en":"sorry","zh":"对不起","ipa":"/ˈsɑri/","pack":"starter","tags":[],"pos":"形","example":"I am sorry.","exampleZh":"我很抱歉。","mnemonic":"「扫瑞」，心里过意不去。"},{"id":"welcome","en":"welcome","zh":"欢迎","ipa":"/ˈwɛlkəm/","pack":"starter","tags":[],"pos":"叹","example":"You are welcome.","exampleZh":"不客气。","mnemonic":"别人谢你，就用它回。"},{"id":"yes","en":"yes","zh":"是的","ipa":"/jɛs/","pack":"starter","tags":[],"pos":"叹","example":"Yes, I am.","exampleZh":"是的，我是。","mnemonic":"点头。嘴角拉开。"},{"id":"no","en":"no","zh":"不","ipa":"/noʊ/","pack":"starter","tags":[],"pos":"叹","example":"No, thank you.","exampleZh":"不用，谢谢。","mnemonic":"摇头。嘴唇收圆。"},{"id":"ok","en":"OK","zh":"好的","ipa":"/oʊˈkeɪ/","pack":"starter","tags":[],"pos":"叹","example":"OK, I go.","exampleZh":"好，我走了。","mnemonic":"两个字母，全世界都懂。"},{"id":"i","en":"I","zh":"我","ipa":"/aɪ/","pack":"starter","tags":[],"pos":"代","example":"I am here.","exampleZh":"我在这里。","mnemonic":"永远大写。一个字母就是我。"},{"id":"you","en":"you","zh":"你","ipa":"/ju/","pack":"starter","tags":[],"pos":"代","example":"You are good.","exampleZh":"你很好。","mnemonic":"对着对方，读「优」。"},{"id":"my","en":"my","zh":"我的","ipa":"/maɪ/","pack":"starter","tags":[],"pos":"代","example":"This is my book.","exampleZh":"这是我的书。","mnemonic":"很短。你已经会。后面接东西。"},{"id":"your","en":"your","zh":"你的","ipa":"/jɔr/","pack":"starter","tags":[],"pos":"代","example":"This is your pen.","exampleZh":"这是你的笔。","mnemonic":"you 再加上「属于」。"},{"id":"he","en":"he","zh":"他","ipa":"/hi/","pack":"starter","tags":[],"pos":"代","example":"He is my friend.","exampleZh":"他是我的朋友。","mnemonic":"读 hee，指一位男性。"},{"id":"she","en":"she","zh":"她","ipa":"/ʃi/","pack":"starter","tags":[],"pos":"代","example":"She is here.","exampleZh":"她在这里。","mnemonic":"读 shee，指一位女性。"},{"id":"it","en":"it","zh":"它","ipa":"/ɪt/","pack":"starter","tags":[],"pos":"代","example":"It is a pen.","exampleZh":"它是一支笔。","mnemonic":"指东西，又短又轻。"},{"id":"we","en":"we","zh":"我们","ipa":"/wi/","pack":"starter","tags":[],"pos":"代","example":"We are friends.","exampleZh":"我们是朋友。","mnemonic":"把你我圈在一起。"},{"id":"they","en":"they","zh":"他们","ipa":"/ðeɪ/","pack":"starter","tags":[],"pos":"代","example":"They are good.","exampleZh":"他们很好。","mnemonic":"指另外那些人。舌尖轻咬。"},{"id":"me","en":"me","zh":"我","ipa":"/mi/","pack":"starter","tags":[],"pos":"代","example":"Look at me.","exampleZh":"看着我。","mnemonic":"动作落到自己身上用 me。"},{"id":"name","en":"name","zh":"名字","ipa":"/neɪm/","pack":"starter","tags":[],"pos":"名","example":"My name is Ann.","exampleZh":"我的名字是安。","mnemonic":"问名字就问这个词。"},{"id":"friend","en":"friend","zh":"朋友","ipa":"/frɛnd/","pack":"starter","tags":[],"pos":"名","example":"You are my friend.","exampleZh":"你是我的朋友。","mnemonic":"fri-end，关系里的那个人。"},{"id":"am","en":"am","zh":"是","ipa":"/æm/","pack":"starter","tags":[],"pos":"动","example":"I am Tom.","exampleZh":"我是汤姆。","mnemonic":"只跟 I：I am。"},{"id":"is","en":"is","zh":"是","ipa":"/ɪz/","pack":"starter","tags":[],"pos":"动","example":"She is good.","exampleZh":"她很好。","mnemonic":"他、她、它用 is。"},{"id":"are","en":"are","zh":"是","ipa":"/ɑr/","pack":"starter","tags":[],"pos":"动","example":"You are here.","exampleZh":"你在这里。","mnemonic":"you、we、they 用 are。"},{"id":"this","en":"this","zh":"这个","ipa":"/ðɪs/","pack":"starter","tags":[],"pos":"代","example":"This is my bag.","exampleZh":"这是我的包。","mnemonic":"手边的东西。舌尖轻咬。"},{"id":"that","en":"that","zh":"那个","ipa":"/ðæt/","pack":"starter","tags":[],"pos":"代","example":"That is your car.","exampleZh":"那是你的车。","mnemonic":"指远处。嘴比 this 更开。"},{"id":"a","en":"a","zh":"一个","ipa":"/ə/","pack":"starter","tags":[],"pos":"冠","example":"I have a pen.","exampleZh":"我有一支笔。","mnemonic":"很轻。后面的词以辅音开头。"},{"id":"an","en":"an","zh":"一个","ipa":"/æn/","pack":"starter","tags":[],"pos":"冠","example":"I have an egg.","exampleZh":"我有一个蛋。","mnemonic":"后面的词以元音开头时用它。"},{"id":"the","en":"the","zh":"特指","ipa":"/ðə/","pack":"starter","tags":[],"pos":"冠","example":"Open the door.","exampleZh":"打开那扇门。","mnemonic":"你心里已经知道是哪一个。"},{"id":"what","en":"what","zh":"什么","ipa":"/wɑt/","pack":"starter","tags":[],"pos":"代","example":"What is this?","exampleZh":"这是什么？","mnemonic":"问东西。"},{"id":"who","en":"who","zh":"谁","ipa":"/hu/","pack":"starter","tags":[],"pos":"代","example":"Who is she?","exampleZh":"她是谁？","mnemonic":"问人。嘴唇收圆。"},{"id":"where","en":"where","zh":"哪里","ipa":"/wɛr/","pack":"starter","tags":[],"pos":"代","example":"Where is my bag?","exampleZh":"我的包在哪？","mnemonic":"问地点。里面有 here 的影子。"},{"id":"how","en":"how","zh":"怎样","ipa":"/haʊ/","pack":"starter","tags":[],"pos":"副","example":"How are you?","exampleZh":"你好吗？","mnemonic":"问状况。结尾嘴唇收圆。"},{"id":"and","en":"and","zh":"和","ipa":"/ænd/","pack":"starter","tags":[],"pos":"连","example":"You and me.","exampleZh":"你和我。","mnemonic":"把两个东西粘起来。"},{"id":"to","en":"to","zh":"向","ipa":"/tu/","pack":"starter","tags":[],"pos":"介","example":"I go to school.","exampleZh":"我去学校。","mnemonic":"go to 就是去往。和 two 同音。"},{"id":"in","en":"in","zh":"里面","ipa":"/ɪn/","pack":"starter","tags":[],"pos":"介","example":"The pen is in my bag.","exampleZh":"笔在我包里。","mnemonic":"进到里面。"},{"id":"on","en":"on","zh":"上面","ipa":"/ɑn/","pack":"starter","tags":[],"pos":"介","example":"The book is on the bed.","exampleZh":"书在床上。","mnemonic":"贴在表面上。"},{"id":"of","en":"of","zh":"的","ipa":"/ʌv/","pack":"starter","tags":[],"pos":"介","example":"A cup of tea.","exampleZh":"一杯茶。","mnemonic":"很轻，表示一份或所属。"},{"id":"for","en":"for","zh":"给","ipa":"/fɔr/","pack":"starter","tags":[],"pos":"介","example":"This is for you.","exampleZh":"这是给你的。","mnemonic":"上齿轻咬下唇。"},{"id":"with","en":"with","zh":"一起","ipa":"/wɪð/","pack":"starter","tags":[],"pos":"介","example":"I go with you.","exampleZh":"我和你一起去。","mnemonic":"伴随。舌尖轻咬。"},{"id":"go","en":"go","zh":"去","ipa":"/ɡoʊ/","pack":"starter","tags":[],"pos":"动","example":"I go home.","exampleZh":"我回家。","mnemonic":"嘴唇收到更圆。"},{"id":"come","en":"come","zh":"来","ipa":"/kʌm/","pack":"starter","tags":[],"pos":"动","example":"Come here.","exampleZh":"过来。","mnemonic":"朝说话的人走。"},{"id":"see","en":"see","zh":"看见","ipa":"/si/","pack":"starter","tags":[],"pos":"动","example":"I see you.","exampleZh":"我看见你。","mnemonic":"已经看见了。"},{"id":"look","en":"look","zh":"看","ipa":"/lʊk/","pack":"starter","tags":[],"pos":"动","example":"Look at this.","exampleZh":"看这个。","mnemonic":"主动把目光转过去。"},{"id":"like","en":"like","zh":"喜欢","ipa":"/laɪk/","pack":"starter","tags":[],"pos":"动","example":"I like tea.","exampleZh":"我喜欢茶。","mnemonic":"和 my 一样，从啊滑向衣。"},{"id":"want","en":"want","zh":"想要","ipa":"/wɑnt/","pack":"starter","tags":[],"pos":"动","example":"I want water.","exampleZh":"我想要水。","mnemonic":"心里想得到。"},{"id":"need","en":"need","zh":"需要","ipa":"/nid/","pack":"starter","tags":[],"pos":"动","example":"I need help.","exampleZh":"我需要帮助。","mnemonic":"不是想要，是缺了不行。"},{"id":"have","en":"have","zh":"有","ipa":"/hæv/","pack":"starter","tags":[],"pos":"动","example":"I have a book.","exampleZh":"我有一本书。","mnemonic":"结尾是会振动的 v。"},{"id":"do","en":"do","zh":"做","ipa":"/du/","pack":"starter","tags":[],"pos":"动","example":"I do it.","exampleZh":"我来做这件事。","mnemonic":"嘴唇收圆。"},{"id":"can","en":"can","zh":"能够","ipa":"/kæn/","pack":"starter","tags":[],"pos":"动","example":"I can read.","exampleZh":"我能读。","mnemonic":"表示做得到。嘴张大。"},{"id":"eat","en":"eat","zh":"吃","ipa":"/it/","pack":"starter","tags":[],"pos":"动","example":"I eat rice.","exampleZh":"我吃饭。","mnemonic":"长衣音，嘴角拉开。"},{"id":"drink","en":"drink","zh":"喝","ipa":"/drɪŋk/","pack":"starter","tags":[],"pos":"动","example":"I drink water.","exampleZh":"我喝水。","mnemonic":"喝的是液体。"},{"id":"water","en":"water","zh":"水","ipa":"/ˈwɔtər/","pack":"starter","tags":[],"pos":"名","example":"I drink water.","exampleZh":"我喝水。","mnemonic":"圆唇开头，像「沃特」。"},{"id":"book","en":"book","zh":"书","ipa":"/bʊk/","pack":"starter","tags":[],"pos":"名","example":"This is my book.","exampleZh":"这是我的书。","mnemonic":"短乌音。和 good 一家。"},{"id":"pen","en":"pen","zh":"笔","ipa":"/pɛn/","pack":"starter","tags":[],"pos":"名","example":"This is a pen.","exampleZh":"这是一支笔。","mnemonic":"p 只出气，喉咙不震。"},{"id":"home","en":"home","zh":"家","ipa":"/hoʊm/","pack":"starter","tags":[],"pos":"名","example":"I go home.","exampleZh":"我回家。","mnemonic":"不是房子，是你要回去的地方。"},{"id":"school","en":"school","zh":"学校","ipa":"/skul/","pack":"starter","tags":[],"pos":"名","example":"I go to school.","exampleZh":"我去学校。","mnemonic":"sk 连读，中间别加元音。"},{"id":"day","en":"day","zh":"天","ipa":"/deɪ/","pack":"starter","tags":[],"pos":"名","example":"Have a good day.","exampleZh":"祝你有美好的一天。","mnemonic":"从诶滑向衣。"},{"id":"time","en":"time","zh":"时间","ipa":"/taɪm/","pack":"starter","tags":[],"pos":"名","example":"What time is it?","exampleZh":"现在几点？","mnemonic":"和 my 是同一个元音。"},{"id":"today","en":"today","zh":"今天","ipa":"/təˈdeɪ/","pack":"starter","tags":[],"pos":"名","example":"I read today.","exampleZh":"我今天读书。","mnemonic":"to 加 day，就是这一天。"},{"id":"now","en":"now","zh":"现在","ipa":"/naʊ/","pack":"starter","tags":[],"pos":"副","example":"Come here now.","exampleZh":"现在过来。","mnemonic":"结尾一定把嘴唇收圆。"},{"id":"one","en":"one","zh":"一","ipa":"/wʌn/","pack":"starter","tags":[],"pos":"数","example":"I have one pen.","exampleZh":"我有一支笔。","mnemonic":"字母是 o，读音却以 w 开头。"},{"id":"two","en":"two","zh":"二","ipa":"/tu/","pack":"starter","tags":[],"pos":"数","example":"I have two books.","exampleZh":"我有两本书。","mnemonic":"和 to 同音，靠意思分开。"},{"id":"three","en":"three","zh":"三","ipa":"/θri/","pack":"starter","tags":[],"pos":"数","example":"I see three friends.","exampleZh":"我看见三位朋友。","mnemonic":"舌尖要伸出来。"},{"id":"four","en":"four","zh":"四","ipa":"/fɔr/","pack":"starter","tags":[],"pos":"数","example":"I have four pens.","exampleZh":"我有四支笔。","mnemonic":"上齿咬住下唇。"},{"id":"five","en":"five","zh":"五","ipa":"/faɪv/","pack":"starter","tags":[],"pos":"数","example":"I have five books.","exampleZh":"我有五本书。","mnemonic":"结尾是 v，不是 f。"},{"id":"six","en":"six","zh":"六","ipa":"/sɪks/","pack":"starter","tags":[],"pos":"数","example":"I have six pens.","exampleZh":"我有六支笔。","mnemonic":"结尾是 ks。"},{"id":"seven","en":"seven","zh":"七","ipa":"/ˈsɛvən/","pack":"starter","tags":[],"pos":"数","example":"I have seven books.","exampleZh":"我有七本书。","mnemonic":"中间那个音很轻。"},{"id":"eight","en":"eight","zh":"八","ipa":"/eɪt/","pack":"starter","tags":[],"pos":"数","example":"I have eight pens.","exampleZh":"我有八支笔。","mnemonic":"和 day 同一个元音。"},{"id":"nine","en":"nine","zh":"九","ipa":"/naɪn/","pack":"starter","tags":[],"pos":"数","example":"I have nine books.","exampleZh":"我有九本书。","mnemonic":"和 hi、my 一家。"},{"id":"ten","en":"ten","zh":"十","ipa":"/tɛn/","pack":"starter","tags":[],"pos":"数","example":"I have ten pens.","exampleZh":"我有十支笔。","mnemonic":"短促的诶。"}]