","ipa":"/ˈoʊnər/","pack":"ui","tags":[],"pos":"名","example":"The owner can edit.","exampleZh":"所有者可以改。","mnemonic":"仓库归谁。"},{"id":"check","en":"check","zh":"检查","ipa":"/tʃɛk/","pack":"ui","tags":[],"pos":"动","example":"Check this file.","exampleZh":"检查这个文件。","mnemonic":"对勾。Checks 页就是一组检查。"},{"id":"checkout","en":"checkout","zh":"检出","ipa":"/ˈtʃɛkaʊt/","pack":"ui","tags":[],"pos":"动","example":"Checkout this branch.","exampleZh":"检出这个分支。","mnemonic":"把那个分支拿到你眼前。"},{"id":"refresh","en":"refresh","zh":"刷新","ipa":"/rɪˈfrɛʃ/","pack":"ui","tags":[],"pos":"动","example":"Refresh the page.","exampleZh":"刷新页面。","mnemonic":"再要一次最新的。"},{"id":"done","en":"done","zh":"完成","ipa":"/dʌn/","pack":"ui","tags":[],"pos":"形","example":"You are done.","exampleZh":"你完成了。","mnemonic":"短啊。可以歇一下。"},{"id":"rename","en":"rename","zh":"改名","ipa":"/ˌriˈneɪm/","pack":"ui","tags":[],"pos":"动","example":"Rename this file.","exampleZh":"给文件改名。","mnemonic":"re 再一次，name 名字。"},{"id":"import","en":"import","zh":"导入","ipa":"/ˈɪmpɔrt/","pack":"ui","tags":[],"pos":"动","example":"Import a file.","exampleZh":"导入一个文件。","mnemonic":"从外面拿进来。"},{"id":"export","en":"export","zh":"导出","ipa":"/ˈɛkspɔrt/","pack":"ui","tags":[],"pos":"动","example":"Export the data.","exampleZh":"导出数据。","mnemonic":"送到外面去。"},{"id":"sync","en":"sync","zh":"同步","ipa":"/sɪŋk/","pack":"ui","tags":[],"pos":"动","example":"Please sync now.","exampleZh":"请现在同步。","mnemonic":"让两边变成一样。"},{"id":"update","en":"update","zh":"更新","ipa":"/ʌpˈdeɪt/","pack":"ui","tags":[],"pos":"动","example":"Update this file.","exampleZh":"更新这个文件。","mnemonic":"让它变成新的。"},{"id":"install","en":"install","zh":"安装","ipa":"/ɪnˈstɔl/","pack":"ui","tags":[],"pos":"动","example":"Install the app.","exampleZh":"安装应用。","mnemonic":"装上才能用。"},{"id":"enable","en":"enable","zh":"启用","ipa":"/ɪˈneɪbəl/","pack":"ui","tags":[],"pos":"动","example":"Enable this option.","exampleZh":"启用这个选项。","mnemonic":"把开关打开。"},{"id":"disable","en":"disable","zh":"停用","ipa":"/dɪsˈeɪbəl/","pack":"ui","tags":[