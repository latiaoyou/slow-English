会话","ipa":"/ˌkɑnvərˈseɪʃən/","pack":"ui","tags":[],"pos":"名","example":"Open the conversation.","exampleZh":"打开这段会话。","mnemonic":"评论串成的一条线。"},{"id":"reviewer","en":"reviewer","zh":"审查者","ipa":"/rɪˈvjuər/","pack":"ui","tags":[],"pos":"名","example":"Add a reviewer.","exampleZh":"加一位审查者。","mnemonic":"review 的那个人。"},{"id":"assignee","en":"assignee","zh":"受理人","ipa":"/əˈsaɪni/","pack":"ui","tags":[],"pos":"名","example":"Add an assignee.","exampleZh":"加一位受理人。","mnemonic":"这件事交给谁做。"},{"id":"collaborator","en":"collaborator","zh":"协作者","ipa":"/kəˈlæbəreɪtər/","pack":"ui","tags":[],"pos":"名","example":"Add a collaborator.","exampleZh":"加一位协作者。","mnemonic":"一起改仓库的人。拆开五拍记。"},{"id":"permission","en":"permission","zh":"权限","ipa":"/pərˈmɪʃən/","pack":"ui","tags":[],"pos":"名","example":"Change the permission.","exampleZh":"改权限。","mnemonic":"谁能看，谁能改。"},{"id":"organization","en":"organization","zh":"组织","ipa":"/ˌɔrɡənəˈzeɪʃən/","pack":"ui","tags":[],"pos":"名","example":"Open the organization.","exampleZh":"打开组织。","mnemonic":"团队或公司的大账号。"},{"id":"team","en":"team","zh":"团队","ipa":"/tim/","pack":"ui","tags":[],"pos":"名","example":"Join the team.","exampleZh":"加入团队。","mnemonic":"长衣音。一组人。"},{"id":"snippet","en":"snippet","zh":"片段","ipa":"/ˈsnɪpɪt/","pack":"ui","tags":[],"pos":"名","example":"Copy the snippet.","exampleZh":"复制这个片段。","mnemonic":"一小段可以拿走的代码。"},{"id":"overview","en":"overview","zh":"概览","ipa":"/ˈoʊvərvju/","pack":"ui","tags":[],"pos":"名","example":"Open the overview.","exampleZh":"打开概览。","mnemonic":"先看全貌。"},{"id":"security","en":"security","zh":"安全","ipa":"/sɪˈkjʊrəti/","pack":"ui","tags":[],"pos":"名","example":"Open security settings.","exampleZh":"打开安全设置。","mnemonic":"密码、密钥、告警都在这。"},{"id":"alert","en":"alert","zh":"警报","ipa":"/əˈlɝt/","pack":"ui","tags":[],"pos":"名","example":"Read the alert.","exampleZh":"读这条警报。","mnemonic":"跳出来要你看见。"},{"id":"error","en":"error","zh":"错误","ipa":"/ˈɛrər/","pack":"ui","tags":[],"pos":"名","example":"Fix the error.","exampleZh":"把错误修好。","mnemo