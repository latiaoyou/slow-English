[{"id":"cheap","en":"cheap","zh":"便宜","ipa":"/tʃip/","pack":"daily","tags":[],"pos":"形","example":"The tea is cheap.","exampleZh":"这茶便宜。","mnemonic":"吃音加长衣。"},{"id":"expensive","en":"expensive","zh":"贵","ipa":"/ɪkˈspɛnsɪv/","pack":"daily","tags":[],"pos":"形","example":"The bag is expensive.","exampleZh":"这个包很贵。","mnemonic":"四拍。先只记「很贵」。"},{"id":"price","en":"price","zh":"价格","ipa":"/praɪs/","pack":"daily","tags":[],"pos":"名","example":"What is the price?","exampleZh":"价格是多少？","mnemonic":"和 my 同一个元音。"},{"id":"house","en":"house","zh":"房子","ipa":"/haʊs/","pack":"daily","tags":[],"pos":"名","example":"This is my house.","exampleZh":"这是我的房子。","mnemonic":"建筑。home 则是「回家」的家。"},{"id":"phone","en":"phone","zh":"电话","ipa":"/foʊn/","pack":"daily","tags":[],"pos":"名","example":"This is my phone.","exampleZh":"这是我的电话。","mnemonic":"ph 发 f，然后收圆。"},{"id":"sleep","en":"sleep","zh":"睡觉","ipa":"/slip/","pack":"daily","tags":[],"pos":"动","example":"I sleep at night.","exampleZh":"我晚上睡觉。","mnemonic":"长衣音。"},{"id":"walk","en":"walk","zh":"走路","ipa":"/wɔk/","pack":"daily","tags":[],"pos":"动","example":"I walk home.","exampleZh":"我走回家。","mnemonic":"开头的 w 别吞掉。"},{"id":"run","en":"run","zh":"跑","ipa":"/rʌn/","pack":"daily","tags":["ui"],"pos":"动","example":"I run home.","exampleZh":"我跑回家。","mnemonic":"人也用它，按钮 Run 是让程序跑起来。"},{"id":"sit","en":"sit","zh":"坐","ipa":"/sɪt/","pack":"daily","tags":[],"pos":"动","example":"Please sit here.","exampleZh":"请坐这儿。","mnemonic":"短而松，和 ship 一家。"},{"id":"stand","en":"stand","zh":"站","ipa":"/stænd/","pack":"daily","tags":[],"pos":"动","example":"Please stand here.","exampleZh":"请站这儿。","mnemonic":"嘴张大。"},{"id":"buy","en":"buy","zh":"买","ipa":"/baɪ/","pack":"daily","tags":[],"pos":"动","example":"I buy bread.","exampleZh":"我买面包。","mnemonic":"和 my、hi 同元音。"},{"id":"give","en":"give","zh":"给","ipa":"/ɡɪv/","pack":"daily","tags":[],"pos":"动","example":"I give you a pen.","exampleZh":"我给你一支笔。","mnemonic":"结尾要咬唇振动。"},{"id":"take","en":"take","zh":"拿","ipa":"/teɪk/","pack":"daily","tags":[],"pos":"动","example":"Take this book.","exampleZh":"把这本书拿走。","mnemonic":"从诶滑向衣。"},{"id":"play","en":"play","zh":"玩","ipa":"/pleɪ/","pack":"daily","tags":[],"pos":"动","example":"I play with you.","exampleZh":"我和你一起玩。","mnemonic":"和 day 同元音。"},{"id":"work","en":"work","zh":"工作","ipa":"/wɝk/","pack":"daily","tags":[],"pos":"名","example":"I work today.","exampleZh":"我今天工作。","mnemonic":"卷舌。动词名词都是它。"},{"id":"live","en":"live","zh":"住","ipa":"/lɪv/","pack":"daily","tags":[],"pos":"动","example":"I live here.","exampleZh":"我住在这里。","mnemonic":"短衣，结尾是 v。"},{"id":"meet","en":"meet","zh":"见面","ipa":"/mit/","pack":"daily","tags":[],"pos":"动","example":"I meet a friend.","exampleZh":"我见一个朋友。","mnemonic":"长衣音。"},{"id":"call","en":"call","zh":"呼叫","ipa":"/kɔl/","pack":"daily","tags":["ui"],"pos":"动","example":"I call you.","exampleZh":"我打电话给你。","mnemonic":"圆唇。电话按钮也常写 Call。"},{"id":"wait","en":"wait","zh":"等","ipa":"/weɪt/","pack":"daily","tags":[],"pos":"动","example":"Please wait here.","exampleZh":"请在这儿等。","mnemonic":"和 day 同元音。"},{"id":"start","en":"start","zh":"开始","ipa":"/stɑrt/","pack":"daily","tags":["ui"],"pos":"动","example":"I start today.","exampleZh":"我今天开始。","mnemonic":"按钮 Start 就是开始。"},{"id":"learn","en":"learn","zh":"学","ipa":"/lɝn/","pack":"daily","tags":[],"pos":"动","example":"I learn a word.","exampleZh":"我学一个词。","mnemonic":"卷舌。你现在就在 learn。"},{"id":"study","en":"study","zh":"学习","ipa":"/ˈstʌdi/","pack":"daily","tags":[],"pos":"动","example":"I study at home.","exampleZh":"我在家学习。","mnemonic":"坐下来学，比 learn 更「上课」。"},{"id":"remember","en":"remember","zh":"记得","ipa":"/rɪˈmɛmbər/","pack":"daily","tags":[],"pos":"动","example":"I remember you.","exampleZh":"我记得你。","mnemonic":"三拍。忘了的卡会帮你 remember。"},{"id":"forget","en":"forget","zh":"忘记","ipa":"/fərˈɡɛt/","pack":"daily","tags":[],"pos":"动","example":"I forget a word.","exampleZh":"我忘了一个词。","mnemonic":"忘了不要紧，把它标成没记住。"},{"id":"speak","en":"speak","zh":"说","ipa":"/spik/","pack":"daily","tags":[],"pos":"动","example":"Please speak now.","exampleZh":"现在请说。","mnemonic":"长衣。跟读按钮就是请你 speak。"},{"id":"listen","en":"listen","zh":"听","ipa":"/ˈlɪsən/","pack":"daily","tags":[],"pos":"动","example":"Please listen.","exampleZh":"请听。","mnemonic":"点喇叭，就是请机器说给你 listen。"},{"id":"ask","en":"ask","zh":"问","ipa":"/æsk/","pack":"daily","tags":[],"pos":"动","example":"I ask a question.","exampleZh":"我问一个问题。","mnemonic":"嘴张大。先 s 再 k。"},{"id":"tell","en":"tell","zh":"告诉","ipa":"/tɛl/","pack":"daily","tags":[],"pos":"动","example":"Tell me your name.","exampleZh":"告诉我你的名字。","mnemonic":"短诶。"},{"id":"think","en":"think","zh":"想","ipa":"/θɪŋk/","pack":"daily","tags":[],"pos":"动","example":"I think of you.","exampleZh":"我想起你。","mnemonic":"舌尖伸出，结尾是鼻音。"},{"id":"know","en":"know","zh":"知道","ipa":"/noʊ/","pack":"daily","tags":[],"pos":"动","example":"I know your name.","exampleZh":"我知道你的名字。","mnemonic":"k 不发音，只读 no。"},{"id":"feel","en":"feel","zh":"觉得","ipa":"/fil/","pack":"daily","tags":[],"pos":"动","example":"I feel happy.","exampleZh":"我觉得开心。","mnemonic":"长衣音。"},{"id":"make","en":"make","zh":"做","ipa":"/meɪk/","pack":"daily","tags":[],"pos":"动","example":"I make tea.","exampleZh":"我泡茶。","mnemonic":"和 day 同元音。"},{"id":"try","en":"try","zh":"试","ipa":"/traɪ/","pack":"daily","tags":[],"pos":"动","example":"Please try again.","exampleZh":"请再试一次。","mnemonic":"和 my 同元音。"},{"id":"find","en":"find","zh":"找到","ipa":"/faɪnd/","pack":"daily","tags":[],"pos":"动","example":"I find my key.","exampleZh":"我找到钥匙。","mnemonic":"和 my、hi 一家。"},{"id":"put","en":"put","zh":"放","ipa":"/pʊt/","pack":"daily","tags":[],"pos":"动","example":"Put the book here.","exampleZh":"把书放这儿。","mnemonic":"短乌，和 book 一样。"},{"id":"mother","en":"mother","zh":"母亲","ipa":"/ˈmʌðər/","pack":"daily","tags":[],"pos":"名","example":"I love my mother.","exampleZh":"我爱我的母亲。","mnemonic":"比 mom 正式。中间咬舌。"},{"id":"father","en":"father","zh":"父亲","ipa":"/ˈfɑðər/","pack":"daily","tags":[],"pos":"名","example":"I love my father.","exampleZh":"我爱我的父亲。","mnemonic":"中间是 this 的那个咬舌音。"},{"id":"brother","en":"brother","zh":"兄弟","ipa":"/ˈbrʌðər/","pack":"daily","tags":[],"pos":"名","example":"He is my brother.","exampleZh":"他是我的兄弟。","mnemonic":"中间同样咬舌。"},{"id":"sister","en":"sister","zh":"姐妹","ipa":"/ˈsɪstər/","pack":"daily","tags":[],"pos":"名","example":"She is my sister.","exampleZh":"她是我的姐妹。","mnemonic":"两拍，第一拍重。"},{"id":"family","en":"family","zh":"家人","ipa":"/ˈfæməli/","pack":"daily","tags":[],"pos":"名","example":"This is my family.","exampleZh":"这是我的家人。","mnemonic":"嘴先张大。"},{"id":"child","en":"child","zh":"孩子","ipa":"/tʃaɪld/","pack":"daily","tags":[],"pos":"名","example":"The child is small.","exampleZh":"孩子很小。","mnemonic":"吃音开头，元音像 my。"},{"id":"man","en":"man","zh":"男人","ipa":"/mæn/","pack":"daily","tags":[],"pos":"名","example":"He is a man.","exampleZh":"他是一位男人。","mnemonic":"嘴张大，和 cat 一家。"},{"id":"woman","en":"woman","zh":"女人","ipa":"/ˈwʊmən/","pack":"daily","tags":[],"pos":"名","example":"She is a woman.","exampleZh":"她是一位女人。","mnemonic":"第一拍和 book 一样短圆。"},{"id":"boy","en":"boy","zh":"男孩","ipa":"/bɔɪ/","pack":"daily","tags":[],"pos":"名","example":"He is a boy.","exampleZh":"他是男孩。","mnemonic":"先圆唇，再滑向衣。"},{"id":"girl","en":"girl","zh":"女孩","ipa":"/ɡɝl/","pack":"daily","tags":[],"pos":"名","example":"She is a girl.","exampleZh":"她是女孩。","mnemonic":"卷舌，不要读成「勾儿」。"},{"id":"teacher","en":"teacher","zh":"老师","ipa":"/ˈtitʃər/","pack":"daily","tags":[],"pos":"名","example":"She is a teacher.","exampleZh":"她是老师。","mnemonic":"tea 加上椅子的 cher。"},{"id":"student","en":"student","zh":"学生","ipa":"/ˈstudənt/","pack":"daily","tags":[],"pos":"名","example":"I am a student.","exampleZh":"我是学生。","mnemonic":"你现在就是一个 student。"},{"id":"doctor","en":"doctor","zh":"医生","ipa":"/ˈdɑktər/","pack":"daily","tags":[],"pos":"名","example":"He is a doctor.","exampleZh":"他是医生。","mnemonic":"两拍，嘴先张大。"},{"id":"hungry","en":"hungry","zh":"饿","ipa":"/ˈhʌŋɡri/","pack":"daily","tags":[],"pos":"形","example":"I am hungry.","exampleZh":"我饿了。","mnemonic":"中间舌头后部抬起，走鼻音。"},{"id":"tired","en":"tired","zh":"累","ipa":"/ˈtaɪərd/","pack":"daily","tags":[],"pos":"形","example":"I am tired.","exampleZh":"我累了。","mnemonic":"开头和 time 一样。"},{"id":"busy","en":"busy","zh":"忙","ipa":"/ˈbɪzi/","pack":"daily","tags":[],"pos":"形","example":"I am busy today.","exampleZh":"我今天很忙。","mnemonic":"结尾要振动，是 z 不是 s。"},{"id":"free","en":"free","zh":"有空","ipa":"/fri/","pack":"daily","tags":[],"pos":"形","example":"I am free today.","exampleZh":"我今天有空。","mnemonic":"长衣。也可以表示免费。"},{"id":"early","en":"early","zh":"早","ipa":"/ˈɝli/","pack":"daily","tags":[],"pos":"形","example":"I am early.","exampleZh":"我来早了。","mnemonic":"卷舌开头。"},{"id":"late","en":"late","zh":"迟","ipa":"/leɪt/","pack":"daily","tags":[],"pos":"形","example":"I am late.","exampleZh":"我迟到了。","mnemonic":"和 day 同元音。"},{"id":"fast","en":"fast","zh":"快","ipa":"/fæst/","pack":"daily","tags":[],"pos":"形","example":"The bus is fast.","exampleZh":"这趟公交很快。","mnemonic":"嘴张大。"},{"id":"slow","en":"slow","zh":"慢","ipa":"/sloʊ/","pack":"daily","tags":[],"pos":"形","example":"The bus is slow.","exampleZh":"这趟公交很慢。","mnemonic":"朗读选「慢速」时，就是 slow。"},{"id":"long","en":"long","zh":"长","ipa":"/lɔŋ/","pack":"daily","tags":[],"pos":"形","example":"The day is long.","exampleZh":"这一天很长。","mnemonic":"结尾鼻音，后面不要再加 g。"},{"id":"short","en":"short","zh":"短","ipa":"/ʃɔrt/","pack":"daily","tags":[],"pos":"形","example":"The pen is short.","exampleZh":"这支笔很短。","mnemonic":"嘘音加圆唇。"},{"id":"clean","en":"clean","zh":"干净","ipa":"/klin/","pack":"daily","tags":[],"pos":"形","example":"The room is clean.","exampleZh":"房间很干净。","mnemonic":"长衣音。"},{"id":"dirty","en":"dirty","zh":"脏","ipa":"/ˈdɝti/","pack":"daily","tags":[],"pos":"形","example":"My bag is dirty.","exampleZh":"我的包脏了。","mnemonic":"卷舌。"},{"id":"young","en":"young","zh":"年轻","ipa":"/jʌŋ/","pack":"daily","tags":[],"pos":"形","example":"She is young.","exampleZh":"她很年轻。","mnemonic":"yes 的滑音开头。"},{"id":"old","en":"old","zh":"旧","ipa":"/oʊld/","pack":"daily","tags":[],"pos":"形","example":"This book is old.","exampleZh":"这本书旧了。","mnemonic":"也用来表示年纪大。"},{"id":"beautiful","en":"beautiful","zh":"美","ipa":"/ˈbjutəfəl/","pack":"daily","tags":[],"pos":"形","example":"The park is beautiful.","exampleZh":"公园很美。","mnemonic":"三拍：byu、tuh、ful。"},{"id":"kind","en":"kind","zh":"友善","ipa":"/kaɪnd/","pack":"daily","tags":[],"pos":"形","example":"You are kind.","exampleZh":"你很友善。","mnemonic":"元音和 my 一样。"},{"id":"left","en":"left","zh":"左边","ipa":"/lɛft/","pack":"daily","tags":[],"pos":"名","example":"Look left.","exampleZh":"往左看。","mnemonic":"舌尖抵住的 l。"},{"id":"right","en":"right","zh":"右边","ipa":"/raɪt/","pack":"daily","tags":[],"pos":"名","example":"Look right.","exampleZh":"往右看。","mnemonic":"也表示「对」。和 write 同音。"},{"id":"again","en":"again","zh":"再","ipa":"/əˈɡɛn/","pack":"daily","tags":[],"pos":"副","example":"Please try again.","exampleZh":"请再试一次。","mnemonic":"第一拍很轻。"},{"id":"always","en":"always","zh":"总是","ipa":"/ˈɔlweɪz/","pack":"daily","tags":[],"pos":"副","example":"I always read.","exampleZh":"我总是读书。","mnemonic":"重音在最前面。"},{"id":"never","en":"never","zh":"从不","ipa":"/ˈnɛvər/","pack":"daily","tags":[],"pos":"副","example":"I never forget you.","exampleZh":"我从不忘了你。","mnemonic":"中间是振动的 v。"},{"id":"soon","en":"soon","zh":"不久","ipa":"/sun/","pack":"daily","tags":[],"pos":"副","example":"See you soon.","exampleZh":"回头见。","mnemonic":"长乌，和 food 一家。"},{"id":"tomorrow","en":"tomorrow","zh":"明天","ipa":"/təˈmɑroʊ/","pack":"daily","tags":[],"pos":"名","example":"See you tomorrow.","exampleZh":"明天见。","mnemonic":"三拍，重音在中间。"},{"id":"yesterday","en":"yesterday","zh":"昨天","ipa":"/ˈjɛstərdeɪ/","pack":"daily","tags":[],"pos":"名","example":"I read yesterday.","exampleZh":"我昨天读了书。","mnemonic":"yes 加上 ter 加上 day。"},{"id":"week","en":"week","zh":"星期","ipa":"/wik/","pack":"daily","tags":[],"pos":"名","example":"I work this week.","exampleZh":"我这周工作。","mnemonic":"长衣音。"},{"id":"month","en":"month","zh":"月","ipa":"/mʌnθ/","pack":"daily","tags":[],"pos":"名","example":"This month is hot.","exampleZh":"这个月很热。","mnemonic":"结尾舌尖伸出来。"},{"id":"year","en":"year","zh":"年","ipa":"/jɪr/","pack":"daily","tags":[],"pos":"名","example":"A new year.","exampleZh":"新的一年。","mnemonic":"yes 的滑音开头。"},{"id":"hour","en":"hour","zh":"小时","ipa":"/ˈaʊər/","pack":"daily","tags":[],"pos":"名","example":"One hour.","exampleZh":"一个小时。","mnemonic":"h 不发音，从圆唇开始。"},{"id":"minute","en":"minute","zh":"分钟","ipa":"/ˈmɪnɪt/","pack":"daily","tags":[],"pos":"名","example":"One minute.","exampleZh":"一分钟。","mnemonic":"两拍都轻短。"},{"id":"people","en":"people","zh":"人们","ipa":"/ˈpipəl/","pack":"daily","tags":["ui"],"pos":"名","example":"People are here.","exampleZh":"人们在这里。","mnemonic":"GitHub 的 People 页就是成员们。"},{"id":"music","en":"music","zh":"音乐","ipa":"/ˈmjuzɪk/","pack":"daily","tags":[],"pos":"名","example":"I like music.","exampleZh":"我喜欢音乐。","mnemonic":"myu-zik 两拍。"},{"id":"song","en":"song","zh":"歌","ipa":"/sɔŋ/","pack":"daily","tags":[],"pos":"名","example":"I like this song.","exampleZh":"我喜欢这首歌。","mnemonic":"结尾只留鼻音。"}]